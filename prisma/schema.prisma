// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Status {
  active
  inactive
}

enum MatchStatus {
  scheduled
  played
  postponed
  cancelled
}

enum CardType {
  yellow
  red
}

enum SeasonStatus {
  active
  archived
}

enum LeagueCategory {
  primera_division
  division_ascenso
  segunda_division
}

// Un torneo/temporada. Los partidos y ajustes de puntos pertenecen a una
// temporada; al "reiniciar" el torneo se archiva la temporada activa (queda
// como historial consultable) y se abre una nueva en blanco. Equipos,
// jugadores y canchas no estan ligados a una temporada: se reutilizan entre
// torneos.
model Season {
  id        String       @id @default(uuid())
  name      String
  startDate DateTime     @default(now()) @map("start_date")
  endDate   DateTime?    @map("end_date")
  status    SeasonStatus @default(active)

  matches          Match[]
  pointAdjustments PointAdjustment[]

  @@map("seasons")
}

model Team {
  id             String         @id @default(uuid())
  name           String
  photo          Bytes?
  photoType      String?        @map("photo_type")
  photoUpdatedAt DateTime?      @map("photo_updated_at")
  registeredAt   DateTime       @default(now()) @map("registered_at")
  category     LeagueCategory @default(primera_division)
  status       Status         @default(active)
  // 3-letter prefix used to build player folios (ej. "TIG-001"). Nullable at
  // the DB level so existing teams can be backfilled by a script instead of
  // a migration — required at the app layer for every new team.
  folioPrefix  String?        @unique @map("folio_prefix")

  players          Player[]
  homeMatches      Match[]           @relation("HomeTeam")
  awayMatches      Match[]           @relation("AwayTeam")
  pointAdjustments PointAdjustment[]

  @@map("teams")
}

model Player {
  id                 String    @id @default(uuid())
  teamId             String    @map("team_id")
  name               String
  photo              Bytes?
  photoType          String?   @map("photo_type")
  photoUpdatedAt     DateTime? @map("photo_updated_at")
  birthDate          DateTime? @map("birth_date")
  registrationNumber String    @unique @map("registration_number")
  registeredAt       DateTime  @default(now()) @map("registered_at")
  status             Status    @default(active)

  team  Team   @relation(fields: [teamId], references: [id])
  cards Card[]

  @@map("players")
}

model Field {
  id       String  @id @default(uuid())
  name     String
  location String?
  status   Status  @default(active)

  matches Match[]

  @@map("fields")
}

model Match {
  id         String      @id @default(uuid())
  seasonId   String      @map("season_id")
  homeTeamId String      @map("home_team_id")
  awayTeamId String      @map("away_team_id")
  fieldId    String      @map("field_id")
  refereeId  String?     @map("referee_id")
  matchday   Int
  date       DateTime
  time       String?
  homeGoals  Int?        @map("home_goals")
  awayGoals  Int?        @map("away_goals")
  forfeit    Boolean     @default(false)
  forfeitReason String?  @map("forfeit_reason")
  statusReason String?   @map("status_reason")
  resultLocked Boolean   @default(false) @map("result_locked")
  status     MatchStatus @default(scheduled)
  // Set only when an admin corrects an already-confirmed result — stays
  // null for a match's first (normal) registration. See matchService.registerResult.
  resultEditedAt   DateTime? @map("result_edited_at")
  resultEditedById String?   @map("result_edited_by_id")

  season          Season           @relation(fields: [seasonId], references: [id])
  homeTeam        Team             @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeam        Team             @relation("AwayTeam", fields: [awayTeamId], references: [id])
  field           Field            @relation(fields: [fieldId], references: [id])
  referee         User?            @relation("MatchReferee", fields: [refereeId], references: [id])
  resultEditor    User?            @relation("MatchResultEditor", fields: [resultEditedById], references: [id])
  cards           Card[]
  evidence        MatchEvidence[]
  sanctionMatches SanctionMatch[]

  @@index([refereeId])
  @@map("matches")
}

enum MatchEvidenceSlot {
  front
  back
}

// Foto de la cédula arbitral subida al registrar el resultado (anverso y
// reverso) — exactamente un registro por (match, slot); volver a subir a un
// slot reemplaza la foto anterior en vez de acumular ("retake"). fecha_carga
// (createdAt) es deliberadamente distinta de Match.date (fecha del partido)
// — son dos conceptos distintos para auditoría, nunca se colapsan en uno.
model MatchEvidence {
  id               String            @id @default(uuid())
  matchId          String            @map("match_id")
  slot             MatchEvidenceSlot
  photo            Bytes
  photoType        String            @map("photo_type")
  uploadedByUserId String            @map("uploaded_by_user_id")
  createdAt        DateTime          @default(now()) @map("created_at")

  match      Match @relation(fields: [matchId], references: [id])
  uploadedBy User  @relation(fields: [uploadedByUserId], references: [id])

  @@unique([matchId, slot])
  @@map("match_evidence")
}

// Cada tarjeta pertenece a un jugador en un partido especifico.
// Los conteos por equipo (amarillas/rojas/totales) y los puntos
// se calculan en consulta a partir de esta tabla, no se almacenan
// en Match, para evitar que queden desincronizados.
model Card {
  id         String   @id @default(uuid())
  playerId   String   @map("player_id")
  matchId    String   @map("match_id")
  type       CardType
  amount     Decimal? @db.Decimal(10, 2)
  detail     String?
  recordedAt DateTime @default(now()) @map("recorded_at")
  paid       Boolean  @default(false)
  status     Status   @default(active)

  player    Player     @relation(fields: [playerId], references: [id])
  match     Match      @relation(fields: [matchId], references: [id])
  sanctions Sanction[]

  @@map("cards")
}

// Suspension derivada de una tarjeta (no toda tarjeta genera una).
model Sanction {
  id               String  @id @default(uuid())
  cardId           String  @map("card_id")
  matchdayStart    Int     @map("matchday_start")
  matchdayEnd      Int     @map("matchday_end")
  matchesSuspended Int     @map("matches_suspended")
  fulfilled        Boolean @default(false)
  waivedByPayment  Boolean @default(false) @map("waived_by_payment")
  status           Status  @default(active)

  card           Card            @relation(fields: [cardId], references: [id])
  appliedMatches SanctionMatch[]

  @@map("sanctions")
}

// Registro de qué partidos ya se aplicaron (consumieron) contra una
// sanción — la fuente de verdad para "restantes", nunca un contador mutable.
// Poblado únicamente cuando un partido pasa a status "played" via
// matchService.registerResult(); un partido cancelado/pospuesto nunca
// genera una fila aquí.
model SanctionMatch {
  id         String   @id @default(uuid())
  sanctionId String   @map("sanction_id")
  matchId    String   @map("match_id")
  createdAt  DateTime @default(now()) @map("created_at")

  sanction Sanction @relation(fields: [sanctionId], references: [id])
  match    Match    @relation(fields: [matchId], references: [id])

  @@unique([sanctionId, matchId])
  @@map("sanction_matches")
}

// Precio "de hoy" por (tipo de tarjeta, motivo). Card.amount congela este
// valor al momento de crear la tarjeta — cambiar aquí nunca altera multas
// ya emitidas.
model CardReasonConfig {
  id        String   @id @default(uuid())
  cardType  CardType @map("card_type")
  reason    String
  amount    Decimal  @db.Decimal(10, 2)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([cardType, reason])
  @@map("card_reason_configs")
}

// Ajustes manuales a la tabla de posiciones (ej. corregir un marcador
// histórico que nunca se cargó como partido real, o un descuento
// disciplinario de puntos) — cada fila es un delta que se SUMA encima de lo
// calculado a partir de partidos reales (ver la vista `standings`), nunca
// un valor absoluto que la reemplace. Registro tipo bitácora: varios ajustes
// para el mismo equipo se acumulan, cada uno con su propio motivo.
model PointAdjustment {
  id                String   @id @default(uuid())
  seasonId          String   @map("season_id")
  teamId            String   @map("team_id")
  playedDelta       Int      @default(0) @map("played_delta")
  pendingDelta      Int      @default(0) @map("pending_delta")
  wonDelta          Int      @default(0) @map("won_delta")
  drawnDelta        Int      @default(0) @map("drawn_delta")
  lostDelta         Int      @default(0) @map("lost_delta")
  goalsForDelta     Int      @default(0) @map("goals_for_delta")
  goalsAgainstDelta Int      @default(0) @map("goals_against_delta")
  pointsDelta       Int      @default(0) @map("points_delta")
  reason            String
  date              DateTime @default(now())
  status            Status   @default(active)

  season Season @relation(fields: [seasonId], references: [id])
  team   Team   @relation(fields: [teamId], references: [id])

  @@map("point_adjustments")
}

// Singleton row (always the same seeded id) holding site branding/theme.
// Read by both the public landing page and the admin portal.
model SiteSettings {
  id              String    @id @default(uuid())
  name            String    @default("Liga de Futbol")
  slogan          String?
  logo            Bytes?
  logoType        String?   @map("logo_type")
  logoUpdatedAt   DateTime? @map("logo_updated_at")
  primaryColor    String    @default("#0d9488") @map("primary_color")
  backgroundColor String    @default("#eef3f1") @map("background_color")
  // Site-wide language for the public site (not the admin panel, which is
  // always Spanish) — one value for every visitor, set by the admin.
  locale          String    @default("es-MX")

  @@map("site_settings")
}

model User {
  id                   String    @id @default(uuid())
  username             String    @unique
  email                String    @unique
  phoneNumber          String?   @map("phone_number")
  photo                Bytes?
  photoType            String?   @map("photo_type")
  photoUpdatedAt       DateTime? @map("photo_updated_at")
  passwordHash         String    @map("password_hash")
  role                 String    @default("admin")
  status               Status    @default(active)
  resetToken           String?   @unique @map("reset_token")
  resetTokenExpiresAt  DateTime? @map("reset_token_expires_at")
  createdAt            DateTime  @default(now()) @map("created_at")

  refereeMatches   Match[]         @relation("MatchReferee")
  editedResults    Match[]         @relation("MatchResultEditor")
  uploadedEvidence MatchEvidence[]

  @@map("users")
}
