{
  "name": "soccer-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "prisma migrate deploy && tsx prisma/seeds/backfill-team-folio-prefixes.ts",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit --incremental false",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "verify": "pnpm typecheck && pnpm lint && pnpm test",
    "ci": "pnpm verify && pnpm build",
    "postinstall": "prisma generate",
    "db:bootstrap-admin": "tsx prisma/bootstrap-admin.ts",
    "db:seed-clausura-caliope": "tsx prisma/seeds/seed-clausura-caliope.ts",
    "db:backfill-folio-prefixes": "tsx prisma/seeds/backfill-team-folio-prefixes.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.7.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-table": "^9.1.0",
    "framer-motion": "^13.1.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.8",
    "lucide-react": "^1.30.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.84.0",
    "resend": "^6.18.1",
    "sharp": "^0.35.3",
    "sonner": "^2.0.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.5",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "pg": "^8.22.0",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.11",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@10.29.2"
}
